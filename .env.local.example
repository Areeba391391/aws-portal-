# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Legacy anon JWT or new publishable key (sb_publishable_...) both work with the JS client
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only — NEVER expose to the browser or commit the real value
# Required for /api/admin/* and credential invitation routes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
